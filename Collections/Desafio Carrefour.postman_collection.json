              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const resposta = pm.response.json();\r",
                      "pm.environment.set(\"id_usuario_cadastrado\", resposta._id);\r",
                      "\r",
                      "pm.test(\"Status code é 200 - Usuário rciado com sucesso\", function () {\r",
                      "    pm.response.to.have.status(201);\r",
                      "});\r",
                      "\r",
                      "pm.test(\"Body contem _id\", function (){\r",
                      "    const resposta = pm.response.json();\r",
                      "    pm.expect(resposta).to.have.property(\"_id\");\r",
                      "})\r",
                      "\r",
                      "pm.test(\"Resposta em menos de 1000ms\", function () {\r",
                      "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
                      "});\r",
                      "\r",
                      "pm.test(\"Mensagem Confirmação cadastro\", function () {\r",
                      "    const resposta = pm.response.json();\r",
                      "    pm.expect(resposta.message).to.equal(\"Cadastro realizado com sucesso\");\r",
                      "});\r",
                      "\r",
                      "\r",
                      "\r",
                      ""
